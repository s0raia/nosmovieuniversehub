# Copy to .env and fill in. Keep values out of this file - it is committed.

# TMDB API Read Access Token (the bearer token, not the v3 key)
TMDB_API_READ_TOKEN=

# Local database credentials. Both default to "movieuniverse" if left empty.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Password assigned to the seeded users (ana, bruno, carla) on import.
SEED_DEFAULT_PASSWORD=

# Optional: host port for Postgres. Leave this line commented out unless
# something already owns 5432 on your machine, e.g. a local Postgres install.
# Commented rather than empty, so the 5432 default applies.
# POSTGRES_PORT=5433
